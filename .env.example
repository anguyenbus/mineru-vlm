# Base URL for OpenAI-compatible VLM endpoint (e.g. http://localhost:11434/v1 for Ollama)
OPENAI_BASE_URL=

# API key for the OpenAI-compatible endpoint; use "none" for local servers that skip auth
OPENAI_API_KEY=

# Model identifier for the OpenAI-compatible backend (e.g. gpt-4o, llava:13b)
VLM_MODEL_NAME=

# Bedrock model ID for the AWS Bedrock VLM backend (e.g. us.anthropic.claude-sonnet-4-5-v1:0)
BEDROCK_VLM_MODEL=

# AWS region for the Bedrock client (default: ap-southeast-2)
AWS_REGION=

# DPI for page rasterisation via pypdfium2 (default: 144)
PARSER_RENDER_DPI=

# Max rendered page size in megapixels before scale clamping (default: 40.0)
PARSER_MAX_RENDER_MP=

# Cache directory for parsed ParserOutput objects (default: ~/.cache/hybrid_doc_parser)
HYBRID_DOC_PARSER_CACHE_DIR=
